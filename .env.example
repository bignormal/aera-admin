AERA_ADMIN_ENVIRONMENT=development
AERA_ADMIN_LISTEN_ADDR=127.0.0.1:8080
AERA_ADMIN_PUBLIC_URL=http://127.0.0.1:8080
AERA_ADMIN_DATABASE_URL=postgres://aera_admin:change-me@127.0.0.1:5432/aera_admin?sslmode=disable
AERA_ADMIN_REDIS_ADDR=127.0.0.1:6379
# JSON array of exact ingress CIDRs. Production must replace [] with the HTTPS termination proxy networks.
AERA_ADMIN_TRUSTED_PROXY_CIDRS=[]
AERA_ADMIN_IDENTITY_ENCRYPTION_KEYS={"active_key_id":"v1","keys":{"v1":"BASE64_32_BYTE_KEY"}}
AERA_ADMIN_IDENTITY_LOOKUP_KEYS={"active_key_id":"v1","keys":{"v1":"BASE64_32_BYTE_KEY"}}
AERA_ADMIN_TOTP_ENCRYPTION_KEYS={"active_key_id":"v1","keys":{"v1":"BASE64_32_BYTE_KEY"}}
AERA_ADMIN_SESSION_HMAC_KEY=BASE64_32_BYTE_KEY
AERA_ADMIN_CSRF_HMAC_KEY=BASE64_32_BYTE_KEY
AERA_ADMIN_OPERATION_HMAC_KEY=BASE64_32_BYTE_KEY
AERA_ADMIN_CLOUD_ENABLED=false
# When enabled, every value below is mandatory. Keep all files outside the repository and image.
# AERA_ADMIN_CLOUD_BASE_URL=https://cloud-admin.internal.example
# AERA_ADMIN_CLOUD_CA_FILE=/run/secrets/aera-cloud-admin-ca.pem
# AERA_ADMIN_CLOUD_CLIENT_CERT_FILE=/run/secrets/aera-admin-client.pem
# AERA_ADMIN_CLOUD_CLIENT_KEY_FILE=/run/secrets/aera-admin-client-key.pem
# AERA_ADMIN_CLOUD_JWT_SIGNING_KEY_FILE=/run/secrets/aera-admin-service-ed25519.pem
# AERA_ADMIN_CLOUD_JWT_ISSUER=aera-admin
# AERA_ADMIN_CLOUD_JWT_SUBJECT=aera-admin-production
# AERA_ADMIN_CLOUD_SCOPES=["users:read","devices:write","sessions:write","accounts:write","operations:read","official_agents:read","official_agent_drafts:write","official_agent_reviews:write","official_agent_releases:write","official_agent_audit:read"]

{
  "name": "agentera-admin",
  "version": "0.1.0",
  "description": "Aera official Agent catalog administration service",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "build:admin": "pnpm --dir admin-web build",
    "build:platform": "pnpm run build && pnpm run build:admin",
    "check:cloud-admin-contract": "node --test scripts/tests/cloud-admin-contract.test.mjs && node scripts/sync-cloud-admin-contract.mjs --check",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:admin": "pnpm --dir admin-web dev",
    "dev:payload": "pnpm dev --port 3100",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "sync:cloud-admin-contract": "node scripts/sync-cloud-admin-contract.mjs",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:admin": "pnpm --dir admin-web test",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:e2e:admin": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.soybean.config.ts",
    "test:e2e:live:platform": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.platform-live.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:live:cloud": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.cloud-live.config.mts",
    "test:live:platform": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.live.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/translations": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "otplib": "^13.4.1",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "28.0.0",
    "openapi-typescript": "7.10.1",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}
